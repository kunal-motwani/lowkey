# YouCam API key (Bearer token) from the YouCam API console
# Either ONE key for everything...
YOUCAM_API_KEY=
# ...or a separate key per API (each overrides YOUCAM_API_KEY for that API)
YOUCAM_KEY_SKIN=
YOUCAM_KEY_TONE=
YOUCAM_KEY_CLOTHES=
YOUCAM_KEY_MAKEUP=
# API host. Docs list https://yce-api-01.makeupar.com ; set your India-region host here if your console shows a different one.
YOUCAM_API_BASE=https://yce-api-01.makeupar.com
# 1 = serve committed cached results for the sample inputs (works with no key)
DEMO_MODE=1
# Optional: LLM-written verdict text. App works without it.
ANTHROPIC_API_KEY=
